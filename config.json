{
  "app_name": "Tango Studio",
  "version": "1.0.0",
  "audio": {
    "supported_extensions": [".mp3", ".wav", ".flac", ".ogg", ".m4a"],
    "default_volume": 80
  },
  "ui": {
    "default_theme": "light",
    "window_geometry": "1000x500",
    "font_family": "Segoe UI",
    "font_size": 10
  },
  "logging": {
    "log_file": "tango_studio.log",
    "log_level": "INFO"
  },
  "playback": {
    "play_on_double_click": true,
    "time_update_interval_ms": 500
  }
}
